/config/telegram_config.php

# DB dump / SQL 備份，可能含真實客戶資料
/DB/*.sql
/EGsystem_20251218_173007.sql
/ST/import_transactions.sql

# 名稱本身即為備份用途的資料夾
/backup erp/

