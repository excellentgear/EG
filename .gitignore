# 備份檔（本專案手動備份慣例產生，數量持續增加）
*.bak-*

# Composer 套件（可用 composer install 重建）
/vendor/

# 使用者上傳的附件資料（非程式碼）
/uploads/

# 含正式環境憑證，不可進版本歷史
