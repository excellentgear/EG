<?php
// 範本檔：實際使用的 src/common/DBConnection.php 不進版本控制（含正式環境密碼）。
// 部署到新環境時，複製本檔為 DBConnection.php 並填入實際連線資訊。

class DBConnection
{

    private $conn;
    private $host;
    private $user;
    private $password;
    private $dbName;
    private $port;

    function __construct($params=array()) {
        $this->conn = false;
        $this->host = '127.0.0.1';
        $this->user = 'YOUR_DB_USER';
        $this->password = 'YOUR_DB_PASSWORD';
        $this->dbName = 'EGsystem';
        $this->port = '3306';
        $this->connect();
    }



    function __destruct() {
        $this->disconnect();
    }

    private function connect() {

        if (!$this->conn) {

            try {

                $this->conn = new PDO('mysql:host='.$this->host.';dbname='.$this->dbName.'', $this->user, $this->password, array(
                    // utf8mb4：utf8(mb3) 的超集，通知標題/內容含 emoji(4-byte) 時才能寫入 live_event
                    PDO::MYSQL_ATTR_INIT_COMMAND => 'SET NAMES utf8mb4',
                    PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
                ));

                if (!$this->conn) {
                    $this->status_fatal = true;
                    echo 'Connection BDD failed';
                    die();
                }
            } catch (Exception $e) {
                die('Erreur : ' . $e->getMessage());
            }
        }

        return $this->conn;
    }

    function disconnect() {
        if ($this->conn) {
            $this->conn = null;
        }
    }

    function getOne($query) {

        $result = $this->conn->prepare($query);
        $ret = $result->execute();

        if (!$ret) {
            echo 'PDO::errorInfo():';
            echo '<br />';
            echo 'error SQL: '.$query;
            die();
        }

        $result->setFetchMode(PDO::FETCH_ASSOC);
        $reponse = $result->fetch();

        return $reponse;
    }

    function getAll($query) {

        $result = $this->conn->prepare($query);
        $ret = $result->execute();

        if (!$ret) {
            echo 'PDO::errorInfo():';
            echo '<br />';
            echo 'error SQL: '.$query;
            die();
        }

        $result->setFetchMode(PDO::FETCH_ASSOC);
        $reponse = $result->fetchAll();

        return $reponse;
    }

    function execute($query) {

        $response = $this->conn->exec($query);

        // 檢查是否出錯（返回 false），但允許影響 0 行的情況（返回 0）
        if ($response === false) {
            $errorInfo = $this->conn->errorInfo();
            echo 'PDO::errorInfo():';
            echo '<br />';
            echo 'error SQL: '.$query;
            echo '<br />';
            echo 'error message: ' . $errorInfo[2];
            die();
        }

        return $response;
    }

    public function getPDO(): PDO {
        return $this->conn;
    }
}
